    "AI_CALL_TIMEOUT_SECONDS": {"kind": "fixed", "value": 90},
    "DOORKEEPER_JWT_ALGORITHM": {"kind": "fixed", "value": "hs256"},
    "DOORKEEPER_JWT_ISS": {"kind": "fixed", "value": "evo-auth-service"},
    "POSTGRES_USERNAME": {"kind": "fixed", "value": "postgres"},
    "POSTGRES_DATABASE": {"kind": "derived", "rule": "database_from_slug_v1"},
