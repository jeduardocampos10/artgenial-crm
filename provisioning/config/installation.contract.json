{
  "schema_version": 1,
  "required_fields": ["schema_version", "installation_name", "slug", "installation_key", "environment", "domains", "administrator", "required_services", "secret_references"],
  "environments": ["development", "staging", "production"],
  "slug_pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
  "required_domains": ["frontend", "crm_api", "auth_api", "core_api", "processor_api", "flow_api"],
  "administrator_fields": ["name", "email"],
  "required_secret_references": ["POSTGRES_PASSWORD", "REDIS_PASSWORD", "JWT_SECRET_KEY", "SECRET_KEY_BASE", "ENCRYPTION_KEY", "DOORKEEPER_JWT_SECRET_KEY", "BOT_RUNTIME_SECRET", "EVOAI_CRM_API_TOKEN"]
}
